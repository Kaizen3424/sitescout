# Copy this file to .env and fill in your own keys.
# Multiple keys: separate them with commas (key1,key2,key3).

FIRECRAWL_API_KEYS=fc-your-first-key,fc-your-second-key
GEMINI_API_KEYS=AIza-your-first-key,AIza-your-second-key

# Optional: use OpenRouter or Morph instead of Google for the design decisions.
# gemini (default) -> Google's Decisions API; openrouter / morph -> their
# equivalent typed-decisions endpoints.
# OpenRouter keys: set OPENROUTER_API_KEYS here, or put one key per line in
# cli/openrouter.txt (that file is git-ignored).
# SITESCOUT_DECISION_PROVIDER=openrouter
# SITESCOUT_OPENROUTER_MODEL=perplexity/pplx-decider-v1.3:free
# SITESCOUT_MAX_KEY_ATTEMPTS=5
# OPENROUTER_API_KEYS=sk-or-your-key

# Morph (System One / reflex): MORPH_API_KEYS here, or one key per line in
# cli/morphllm.txt (also git-ignored). $0.042 per million input tokens.
# SITESCOUT_DECISION_PROVIDER=morph
# SITESCOUT_MORPH_MODEL=reflex
# MORPH_API_KEYS=sk-your-morph-key

# Optional settings (defaults shown)
# SITESCOUT_UPLOAD_BUDGET_KB=300
# SITESCOUT_REACH_OUT_THRESHOLD=0.60
# SITESCOUT_MAYBE_THRESHOLD=0.40
# SITESCOUT_CACHE_TTL_HOURS=12
# SITESCOUT_DECISION_CACHE_TTL_HOURS=72

# --- TypeScript API (api/) ---
# Locally: copy these into .env.local. In production: Vercel Environment Variables.
# SITESCOUT_API_TOKEN=make-this-a-long-random-string
# SITESCOUT_MAX_URLS=5
# SITESCOUT_CONCURRENCY=3

# --- Durable batches for the web interface (web/) ---
# Both come from the Upstash console (free plan). Redis stores job progress and
# reports for 30 days; QStash delivers one message per URL so a closed browser
# never stops a batch. Upstash also writes these as KV_REST_API_URL/TOKEN.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token

# QSTASH_TOKEN and the two signing keys are on the QStash page of the console.
# QSTASH_URL is only needed for a non-default region (e.g. eu-central-1).
# QSTASH_URL=https://qstash-eu-central-1.upstash.io
# QSTASH_TOKEN=your-qstash-token
# QSTASH_CURRENT_SIGNING_KEY=sig_...
# QSTASH_NEXT_SIGNING_KEY=sig_...

# Optional limits for the public web form (defaults shown)
# SITESCOUT_MAX_JOB_URLS=50
# SITESCOUT_JOB_TTL_DAYS=30
# SITESCOUT_JOB_CONCURRENCY=5
# SITESCOUT_JOBS_PER_HOUR=8
# SITESCOUT_DAILY_URL_BUDGET=500

# The public address QStash calls back to. Production works this out from the
# Vercel deployment URL, so set it only for a custom domain or a local tunnel.
# SITESCOUT_PUBLIC_ORIGIN=https://sitescout-dusky.vercel.app

# --- Gemini quota coordination ---
# Every Decisions call is booked against a rolling one-minute budget in Redis,
# both for all keys together (the safe guard when several keys share one Cloud
# project) and for each key on its own. Leave these at the defaults unless your
# Google plan is bigger than the free tier: the free tier allows 50,000 input
# tokens and 200 requests per minute per project.
# SITESCOUT_GEMINI_TOKENS_PER_MINUTE=45000
# SITESCOUT_GEMINI_REQUESTS_PER_MINUTE=180
# SITESCOUT_GEMINI_TOKENS_PER_KEY=45000
# SITESCOUT_GEMINI_REQUESTS_PER_KEY=180
# How many different keys one Decisions call may try before it gives up and
# waits. Every extra key is another chance to be refused, so keep it small.
# SITESCOUT_MAX_KEY_ATTEMPTS=3
# When a website runs into a quota limit it goes back in the queue instead of
# becoming "unscored": first wait 2 minutes, doubling per attempt, and after
# this many attempts it is reported as unscored with the real reason. A daily
# limit waits for midnight Pacific and gets at most two attempts.
# SITESCOUT_QUOTA_RETRY_BASE_MS=120000
# SITESCOUT_QUOTA_MAX_ATTEMPTS=5

# Development only: analyse inside the request instead of via QStash, so no
# public URL is needed. Keep test batches to one or two URLs.
# SITESCOUT_JOBS_INLINE=1
