{
  "name": "sitescout-api",
  "version": "1.1.0",
  "private": true,
  "description": "TypeScript HTTP API for SiteScout, deployed on Vercel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@upstash/qstash": "^2.12.2",
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.11.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
